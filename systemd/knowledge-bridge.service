[Unit]
Description=Knowledge-Bridge MCP Server
Documentation=https://github.com/MementoRC/knowledge-bridge
After=network.target

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/home/%i/ClaudeCode/Servers/knowledge-bridge/development

# Environment (SQLite database auto-creates on first run)
Environment=KNOWLEDGE_BRIDGE_PORT=4003
Environment=KNOWLEDGE_BRIDGE_DB_PATH=/home/%i/.claude/knowledge-bridge/knowledge_bridge.db
Environment=SESSION_INTELLIGENCE_URL=http://127.0.0.1:4002
Environment=UCKN_URL=http://127.0.0.1:4004
Environment=LOG_LEVEL=INFO
Environment=PYTHONPATH=/home/%i/ClaudeCode/Servers/knowledge-bridge/development/src

# Use pixi to run the server
ExecStart=/home/%i/.pixi/bin/pixi run http-server
ExecReload=/bin/kill -HUP $MAINPID

# Restart configuration
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=knowledge-bridge

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/.claude/knowledge-bridge

[Install]
WantedBy=multi-user.target
